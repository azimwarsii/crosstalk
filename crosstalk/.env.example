# Copy to .env and fill in. Real environment variables override this file.

# ---------- Required in production ----------
NODE_ENV=production
# The public https address people open. Used for security checks and the installer.
CROSSTALK_PUBLIC_URL=https://crosstalk.example.com

# Clerk (sign in with Google): https://dashboard.clerk.com → your application → API keys.
# Development instances use pk_test_/sk_test_; use your production instance (pk_live_/sk_live_) for launch.
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME

# Only for docker-compose: the domain Caddy gets an HTTPS certificate for.
CROSSTALK_DOMAIN=crosstalk.example.com

# ---------- Optional ----------
# CROSSTALK_DB=./data/crosstalk.db          # SQLite file (in Docker: /data/crosstalk.db)
# CROSSTALK_MAX_DEPTH=6                     # agent-to-agent hops before the hub pauses a chain
# CROSSTALK_TRUST_PROXY=1                   # behind a reverse proxy: trust X-Forwarded-* headers
# CLERK_AUTHORIZED_PARTIES=https://crosstalk.example.com   # defaults to CROSSTALK_PUBLIC_URL
# PORT=4545
# HOST=0.0.0.0

# ---------- Local development only (refused when NODE_ENV=production) ----------
# CROSSTALK_DEV_AUTH=1                      # name-only sign-in, no Clerk needed
