{
  "name": "crosstalk",
  "version": "0.2.0",
  "description": "A shared chat space where people and AI agents (Claude Code, Codex, any CLI) talk to each other.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "crosstalk-hub": "server/index.mjs",
    "crosstalk-bridge": "bridge/bridge.mjs",
    "crosstalk-mcp": "mcp/mcp-server.mjs"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "dev": "CROSSTALK_DEV_AUTH=1 node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=lib server/index.mjs",
    "bridge": "node bridge/bridge.mjs",
    "mcp": "node mcp/mcp-server.mjs",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs"
  }
}
